{
  "name": "quasar-tool-vscode",
  "displayName": "Quasar UI Tool",
  "description": "VS Code editor integration for Quasar UI page JSON files.",
  "version": "0.1.0",
  "publisher": "local",
  "files": [
    "src/**",
    "generator/**",
    "templates/**",
    "media/**",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "dependencies": {
    "@vue/compiler-dom": "^3.5.38",
    "acorn": "^8.17.0",
    "monaco-editor": "^0.55.1"
  },
  "activationEvents": [
    "onCustomEditor:quasarTool.pageEditor",
    "onCommand:quasarTool.openPageEditor",
    "onCommand:quasarTool.saveActiveEditor",
    "onCommand:quasarTool.watchVue",
    "onCommand:quasarTool.createPiniaStore",
    "onCommand:quasarTool.createJsonFromTaggedPpt",
    "onStartupFinished",
    "workspaceContains:**/.src/store/**/*.json"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "breadcrumbs.enabled": false
    },
    "commands": [
      {
        "command": "quasarTool.openPageEditor",
        "title": "Quasar Tool: Open Page Editor"
      },
      {
        "command": "quasarTool.saveActiveEditor",
        "title": "Quasar Tool: Save Active Editor",
        "icon": "$(save)"
      },
      {
        "command": "quasarTool.watchVue",
        "title": "Quasar Tool: Start Vue Watch",
        "icon": "$(run)"
      },
      {
        "command": "quasarTool.createPiniaStore",
        "title": "Quasar Tool: Pinia 파일 생성",
        "icon": "$(new-file)"
      },
      {
        "command": "quasarTool.createJsonFromTaggedPpt",
        "title": "Quasar Tool: Create JSON from Tagged PPT",
        "icon": "$(file-code)"
      }
    ],
    "keybindings": [
      {
        "command": "quasarTool.saveActiveEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == quasarTool.pageEditor"
      },
      {
        "command": "quasarTool.saveActiveEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "webviewId == 'quasarTool.pageEditor'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quasarTool.watchVue"
        },
        {
          "command": "quasarTool.createPiniaStore"
        },
        {
          "command": "quasarTool.createJsonFromTaggedPpt"
        }
      ],
      "explorer/context": [
        {
          "command": "quasarTool.watchVue",
          "group": "quasarTool@1"
        },
        {
          "command": "quasarTool.createPiniaStore",
          "group": "quasarTool@2"
        }
      ],
      "editor/title": [
        {
          "command": "quasarTool.watchVue",
          "when": "activeCustomEditorId == quasarTool.pageEditor",
          "group": "navigation@10"
        }
      ],
      "file/newFile": [
        {
          "command": "quasarTool.createJsonFromTaggedPpt",
          "group": "quasarTool@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "quasarTool.pageEditor",
        "displayName": "Quasar UI Tool Editor",
        "selector": [
          {
            "filenamePattern": "**/.src/pages/*.json"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
