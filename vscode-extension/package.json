{
  "name": "quasar-ui-editor",
  "displayName": "Quasar UI Editor",
  "description": "VS Code editor integration for Quasar UI page JSON files.",
  "version": "0.1.1",
  "publisher": "ORUM",
  "icon": "media/quasar-tool.png",
  "pricing": "Free",
  "keywords": [
    "quasar",
    "vue",
    "ui builder",
    "json editor",
    "powerpoint"
  ],
  "files": [
    "src/**",
    "generator/**",
    "templates/**",
    "media/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "dependencies": {
    "@vue/compiler-dom": "^3.5.38",
    "acorn": "^8.17.0",
    "monaco-editor": "^0.55.1"
  },
  "activationEvents": [
    "onCustomEditor:quasarTool.pageEditor",
    "onView:quasarTool.projectPropertiesView",
    "onCommand:quasarTool.openPageEditor",
    "onCommand:quasarTool.openManual",
    "onCommand:quasarTool.newQuasarProject",
    "onCommand:quasarTool.saveActiveEditor",
    "onCommand:quasarTool.watchVue",
    "onCommand:quasarTool.createPiniaStore",
    "onCommand:quasarTool.createJsonFromTaggedPpt",
    "onStartupFinished",
    "workspaceContains:**/.src/store/**/*.json"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "breadcrumbs.enabled": false
    },
    "commands": [
      {
        "command": "quasarTool.openManual",
        "title": "Quasar UI Tool Manual",
        "category": "Quasar Tool",
        "icon": "$(book)"
      },
      {
        "command": "quasarTool.newQuasarProject",
        "title": "New Quasar Project",
        "category": "Quasar Tool",
        "icon": "$(new-folder)"
      },
      {
        "command": "quasarTool.openPageEditor",
        "title": "Quasar Tool: Open Page Editor"
      },
      {
        "command": "quasarTool.saveActiveEditor",
        "title": "Quasar Tool: Save Active Editor",
        "icon": "$(save)"
      },
      {
        "command": "quasarTool.watchVue",
        "title": "Quasar Tool: Start Vue Watch",
        "icon": "$(run)"
      },
      {
        "command": "quasarTool.createPiniaStore",
        "title": "Quasar Tool: Pinia 파일 생성",
        "icon": "$(new-file)"
      },
      {
        "command": "quasarTool.createJsonFromTaggedPpt",
        "title": "Quasar Tool: Create JSON from Tagged PPT",
        "icon": "$(file-code)"
      }
    ],
    "keybindings": [
      {
        "command": "quasarTool.saveActiveEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == quasarTool.pageEditor"
      },
      {
        "command": "quasarTool.saveActiveEditor",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "webviewId == 'quasarTool.pageEditor'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quasarTool.openManual"
        },
        {
          "command": "quasarTool.newQuasarProject"
        },
        {
          "command": "quasarTool.watchVue"
        },
        {
          "command": "quasarTool.createPiniaStore"
        },
        {
          "command": "quasarTool.createJsonFromTaggedPpt"
        }
      ],
      "explorer/context": [
        {
          "command": "quasarTool.newQuasarProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@7"
        },
        {
          "command": "quasarTool.openManual",
          "group": "quasarTool@0"
        },
        {
          "command": "quasarTool.watchVue",
          "group": "quasarTool@1"
        },
        {
          "command": "quasarTool.createPiniaStore",
          "group": "quasarTool@2"
        }
      ],
      "editor/title": [
        {
          "command": "quasarTool.openManual",
          "when": "activeCustomEditorId == quasarTool.pageEditor",
          "group": "navigation@0"
        },
        {
          "command": "quasarTool.newQuasarProject",
          "when": "activeCustomEditorId == quasarTool.pageEditor",
          "group": "navigation@1"
        },
        {
          "command": "quasarTool.watchVue",
          "when": "activeCustomEditorId == quasarTool.pageEditor",
          "group": "navigation@10"
        }
      ],
      "file/newFile": [
        {
          "command": "quasarTool.createJsonFromTaggedPpt",
          "group": "quasarTool@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quasarTool",
          "title": "Quasar UI Tool",
          "icon": "media/quasar-tool.svg"
        }
      ]
    },
    "views": {
      "quasarTool": [
        {
          "id": "quasarTool.projectPropertiesView",
          "name": "Project Properties",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "quasarTool.pageEditor",
        "displayName": "Quasar UI Tool Editor",
        "selector": [
          {
            "filenamePattern": "**/.src/pages/*.json"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
